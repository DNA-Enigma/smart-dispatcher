# smart-dispatcher 的 systemd 单元（模板，尚未部署）。
#
# 安装（在云服务器上执行，路径按需替换 /opt/smart-dispatcher）：
#   sudo cp deploy/smart-dispatcher.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now smart-dispatcher
#   systemctl status smart-dispatcher
#   journalctl -u smart-dispatcher -f        # 看日志
#
# 首次部署前必读 docs/12-deployment.md：里面写了几个「不照做就出事故」的点
# （单 worker、.env 权限、绑定地址与反代的关系）。

[Unit]
Description=Smart 调度层 (smart-dispatcher)
Documentation=file:///opt/smart-dispatcher/docs/12-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 非 root 运行。先建用户：
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin smart-dispatcher
User=smart-dispatcher
Group=smart-dispatcher

# 应用用 __file__ 上溯三级定位仓库根（dispatcher/core/settings.py 的 REPO_ROOT），
# 契约文件（config/ prompts/ schemas/）与 .env 都从那里找，**与 cwd 无关**。
# 仍要设 WorkingDirectory：一是给运维一个明确的落脚点，二是将来加 CLI 子命令时
# 相对路径有基准。注意：本项目是 editable 安装，仓库**不能**在装好之后挪位置。
WorkingDirectory=/opt/smart-dispatcher

# .env 是所有密钥与部署事实的唯一来源（LLM_API_KEY / LLM_BASE_URL /
# DISPATCHER_AUTH_TOKEN ...）。这里不带前缀 `-`，即**文件必须存在**——
# 缺了它服务起不来，这是刻意的：文件缺失时应用会以「鉴权关闭」启动并只打一条
# ERROR 日志，那意味着任何能访问本端口的人都能读全部任务与金融截图。
# 宁可起不来，也不要一个敞着门的服务。
# 权限应当是 600 且属主为 smart-dispatcher（.env 里有 LLM_API_KEY 与主令牌）。
EnvironmentFile=/opt/smart-dispatcher/.env

# 日志立刻进 journald，不要在用户态缓冲到进程退出才刷——崩了就看得到最后几行。
Environment=PYTHONUNBUFFERED=1
# 不写 .pyc。配合下面的 ProtectSystem 让代码目录真正只读。
Environment=PYTHONDONTWRITEBYTECODE=1

# ---- 启动命令 ----------------------------------------------------------
# 用 venv 里的解释器 + -m uvicorn，而不是裸 `uvicorn`：避免 PATH 上出现
# 第二个 uvicorn（系统包 / 别的 venv）时静默用错那个。
#
# --host 127.0.0.1：**只绑本地**，由 nginx/caddy 在前面终止 TLS 并反代。
# 想直接对外暴露就改成 0.0.0.0，但那样 HTTPS / 限流 / /docs 的保护都要自己扛，
# 见 docs/12-deployment.md 第 4 节。绑本地时 uvicorn 的 --proxy-headers
# 默认开（Config.proxy_headers=True），而 --forwarded-allow-ips 默认
# "127.0.0.1,::1"——只信任来自同机反代的 X-Forwarded-*，正是我们要的。
#
# --workers 1：**不能加**。子令牌登记簿（TokenRegistry）、任务状态
# （InMemoryStateStore）、媒体、预算账本全在进程内存里，多 worker 会让
# 「A 进程签发的令牌 B 进程不认」「任务提交到 A 却在 B 查不到」。
# 详见 docs/12-deployment.md 第 6 节的内存态清单。
ExecStart=/opt/smart-dispatcher/.venv/bin/python -m uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --no-server-header

# 退出即拉起。崩溃、被 OOM killer 杀掉、`kill` 掉都会回来。
Restart=always
RestartSec=2

# 停机时 uvicorn 会等连接自然结束，而 SSE 是长连接——给个上限，
# 别让 `systemctl restart` 卡到 systemd 超时再 SIGKILL。
TimeoutStopSec=20
KillSignal=SIGTERM

# ---- 日志去向 ----------------------------------------------------------
# stdout/stderr → journald。应用自身没有 FileHandler（已核对），
# 不写任何日志文件，因此不需要 logrotate。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-dispatcher

# ---- 沙箱 --------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

# 更严的变体（可选）：ProtectSystem=strict 会把整个文件系统挂成只读，
# 那时必须显式放行可写目录，例如将来改用 sqlite 后端时：
#   ProtectSystem=strict
#   ReadWritePaths=/opt/smart-dispatcher/data
# 现在默认是内存后端、**不落任何盘**，因此上面的 full 已经够，且不会因为
# 目录不存在而让服务起不来。

[Install]
WantedBy=multi-user.target
