# 复制成 .env 再填。.env 已被 .gitignore 忽略。
#
# 为什么密钥只在这里、不在代码或策略文件里：
# 契约中 model_tiers.*.model_ref 写作 secret://llm/<tier>_model，
# 解析规则只有一条：secret://<group>/<key> → 环境变量 <GROUP>_<KEY>（全大写）。
# 因此 "档位 → 模型 → 密钥" 这条链上没有任何一环是可提交的文本。

LLM_API_KEY=

# 供应商的 OpenAI 兼容端点。适配器调用 {LLM_BASE_URL}/chat/completions。
LLM_BASE_URL=

# 三个档位各自绑定的模型名。M1 阶段可以三个填同一个模型——
# 这一阶段验证的是机制（LLM 能否从配置渲染的菜单里选、守卫能否拦住越界），
# 不是比较不同模型的质量。
LLM_CHEAP_MODEL=
LLM_STANDARD_MODEL=
LLM_STRONG_MODEL=

# 可选：限流与超时覆盖（默认值来自 routing.policy.yaml 与 limiter 自身配置）
# LLM_QPS=
# LLM_MAX_CONCURRENCY=

# 接口鉴权。这是**主令牌**（master）：所有者的凭据，也是唯一的**发放者**
# ——POST /v1/tokens 用它签发绑定到别的 tenant/user 的子令牌（多用户试点用，
# 见 docs/03-http-contract.md「认证与身份」与 dispatcher/interface/tokens.py）。
# 子令牌存在进程内，进程重启即全部失效；发放的令牌不过期、无续期。
#
# **留空等于关闭鉴权**：所有任务、媒体与策略端点对任何可达本端口的人开放，
# 且没人能发放令牌。本地开发可以留空（启动时会打一条 ERROR 级日志提醒），
# **生产必须填**。客户端侧对应 DispatcherConfig.bearerToken。
DISPATCHER_AUTH_TOKEN=

# 主令牌绑定到哪个租户/用户。子令牌的 tenant/user 在签发时由请求体给出；
# 请求体里自报的 tenant_id/user_id 与 header 里的 X-Tenant-Id/X-User-Id 一律不采信。
DISPATCHER_TENANT=default
DISPATCHER_USER=owner

# ---------------------------------------------------------------------------
# 状态后端（**生产必须 sqlite**）
# ---------------------------------------------------------------------------
# memory = 全部状态在进程内存里，重启即丢；sqlite = 落一个库文件，跨重启存活。
# 它决定这四类状态是否留存：任务快照与事件流（客户端断线重连的重放源）、
# 已批准的策略版本、已发放的子令牌、上传的媒体。
#
# **本文件里写死 sqlite，而不是留空**：部署清单就是 `cp .env.example .env`，
# 代码里的缺省值必须是"重启即丢"（否则每次跑测试、起本地服务都会在仓库里留下
# 一个 data/ 库，下次读到的是上一次的脏状态）。两边都不兜底的话，"生产忘配"
# 就会变成静默灾难——重启后所有子令牌持有者 401、批准过的策略悄悄回退。
# 应用侧还有一道防线：跑内存后端却配了 DISPATCHER_AUTH_TOKEN 时启动会打 ERROR。
#
# **本地开发/跑测试改成 memory**：内存后端不留任何脏状态，测试之间不会串味。
# （`tests/conftest.py` 里已把测试进程的这一项钉成 memory，与开发者的 .env 无关。）
DISPATCHER_STATE_BACKEND=sqlite

# 库文件位置。留空 = <仓库根>/data/dispatcher.db。
# 生产建议指到仓库外，例如 /var/lib/smart-dispatcher/dispatcher.db——这样
# "重新部署 = 覆盖数据"不再是一件需要记得的事。
# DISPATCHER_STATE_PATH=

# 可选：请求体与连接的自保上限（默认值见 dispatcher/core/settings.py）。
# 这些是"这个进程怎么保护自己"，不是可调的产品策略，因此在这里而不是策略文件里。

# 通用请求体上限（字节，默认 10 MiB）。**边读边判**：Content-Length 声明超限当场 413，
# 没声明或写小了也会在读取过程中越限即断。媒体上传路径取它与策略里
# limits.media.max_bytes 的较大者，因此不需要为了传图把它调大。
# DISPATCHER_MAX_REQUEST_BYTES=

# SSE 并发连接上限（默认 100）。每个订阅占一个连接、一个生成器协程与一个轮询任务；
# 超限返回 429 + Retry-After。**0 表示不限制**。
# DISPATCHER_SSE_MAX_CONNECTIONS=

# 媒体保留期（天）：缺省保留期默认 1，单次上传的 retain_days 会被夹进
# [1, 上界]；上界默认 30。清理周期默认 300 秒。
# 缺省值必须有界——"永不过期"意味着金融截图一直躺在进程内存里。
# （文档里的 retain_days=0 "任务结束即删" 需要调度层在任务终态时删，
#   当前按最短保留期 1 天处理，见 docs/05-media.md。）
# DISPATCHER_MEDIA_RETAIN_DAYS=
# DISPATCHER_MEDIA_RETAIN_MAX_DAYS=
# DISPATCHER_MEDIA_SWEEP_INTERVAL_S=
